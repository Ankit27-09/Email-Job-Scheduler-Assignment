# Copy to .env.production in the repo root on the server and fill in.

DOMAIN=scheduler.example.com

POSTGRES_PASSWORD=change-me
NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://scheduler:change-me@postgres:5432/scheduler
REDIS_URL=redis://redis:6379

FRONTEND_URL=https://scheduler.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://scheduler.example.com/auth/google/callback
JWT_SECRET=

WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_SENDS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
SEND_MAX_ATTEMPTS=3
