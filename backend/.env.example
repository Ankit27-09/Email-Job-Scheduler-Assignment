NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/scheduler
REDIS_URL=redis://localhost:6379

# Where the browser app lives (used for CORS and the post-login redirect)
FRONTEND_URL=http://localhost:5173

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Any long random string
JWT_SECRET=change-me

# Worker / throughput
WORKER_CONCURRENCY=5
# Minimum gap between two sends from the same sender, in ms
MIN_DELAY_BETWEEN_SENDS_MS=2000
# Hard ceiling per sender per clock hour, regardless of what a campaign asks for
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Retries for transient SMTP failures
SEND_MAX_ATTEMPTS=3
